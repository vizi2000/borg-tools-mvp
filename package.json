{
  "name": "borg-tools-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:unit": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "npm run test:e2e:simple",
    "test:e2e:simple": "HEADLESS=true npx ts-node --project tests/e2e/tsconfig.json tests/e2e/simple-test.ts",
    "test:e2e:full": "HEADLESS=true npx ts-node --project tests/e2e/tsconfig.json tests/e2e/full-site-test.ts",
    "test:e2e:headed": "HEADLESS=false SLOW_MO=500 npx ts-node --project tests/e2e/tsconfig.json tests/e2e/simple-test.ts",
    "test:e2e:debug": "HEADLESS=false SLOW_MO=1000 npx ts-node --project tests/e2e/tsconfig.json tests/e2e/simple-test.ts",
    "test:visual": "npx ts-node --project tests/visual/tsconfig.json tests/visual/smart-visual-tester.ts",
    "test:visual:advanced": "npx ts-node --project tests/visual/tsconfig.json tests/visual/visual-test-suite.ts",
    "e2e:report": "open test-report/test-report.html",
    "visual:report": "open test-report/smart-visual-report.html",
    "doc:log": "python3 docs/dev-logger.py",
    "doc:milestone": "python3 docs/timeline-manager.py milestone",
    "doc:decision": "python3 docs/decision-tracker.py add",
    "doc:progress": "python3 docs/timeline-manager.py progress",
    "doc:report": "python3 docs/timeline-manager.py report",
    "doc:summary": "python3 docs/timeline-manager.py progress && echo '' && python3 docs/dev-logger.py summary"
  },
  "dependencies": {
    "@supabase/auth-helpers-nextjs": "^0.8.7",
    "@supabase/auth-helpers-react": "^0.4.2",
    "@supabase/supabase-js": "^2.38.4",
    "@tanstack/react-query": "^4.36.1",
    "@trpc/client": "^10.45.0",
    "@trpc/next": "^10.45.0",
    "@trpc/react-query": "^10.45.0",
    "@trpc/server": "^10.45.0",
    "@types/fs-extra": "^11.0.4",
    "autoprefixer": "^10.4.16",
    "canvas": "^3.1.2",
    "clsx": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.294.0",
    "next": "14.0.4",
    "openai": "^5.9.0",
    "postcss": "^8.4.32",
    "react": "^18",
    "react-dom": "^18",
    "superjson": "^2.2.1",
    "tailwindcss": "^3.3.6",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/puppeteer": "^5.4.7",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^1.0.4",
    "eslint": "^8",
    "eslint-config-next": "14.0.4",
    "fs-extra": "^11.3.0",
    "playwright": "^1.40.1",
    "prettier": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.5.7",
    "puppeteer": "^24.12.1",
    "puppeteer-screenshot-tester": "^1.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^1.0.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.10.5"
}
